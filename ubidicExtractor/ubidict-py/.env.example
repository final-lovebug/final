# Gemini — test/.env.example과 동일한 규칙(§10 D-38~D-40, test/SPEC.md §6 참고)
# 키 1개만 쓰려면 GEMINI_API_KEY 하나만 채우면 된다.
# 여러 개 등록하면 1번부터 순서대로 쓰다가, 그 키가 쿼터 소진(429)·인증
# 실패(401/403)·무효 키(400 API_KEY_INVALID)로 막히면 자동으로 다음 번호로
# 넘어간다.
GEMINI_API_KEY=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=

# 모델도 마찬가지 — 하나만 쓰려면 GEMINI_MODEL만. 여러 개 등록하면 등록된
# 키를 전부 써도 그 모델이 안 될 때(쿼터 소진·인증 실패·서버 과부하) 자동으로
# 다음 번호로 넘어간다.
GEMINI_MODEL=
# GEMINI_MODEL_1=
# GEMINI_MODEL_2=

# 판정 재현성을 위해 올리지 말 것
GEMINI_TEMPERATURE=0.1

# 안전장치
MAX_LLM_CALLS=20
LLM_CACHE_DIR=.cache

# ── AWS — SQS ─────────────────────────────────────────────
# Spring `dev` 프로필은 LocalStack의 lovebug-llm-request 큐로 요청을 보낸다.
# 이 워커는 메시지의 mode=MOCK이면 모델/DB 조회 없이 고정 결과를 Spring HTTP
# 콜백으로 돌려준다. mode=REAL이면 아래 MySQL로 문서·사전집을 읽고 위 Gemini
# 키로 실제 모델을 부르므로, REAL 요청을 받을 환경에는 둘 다 채워져 있어야
# 한다(둘 중 하나가 비면 작업이 실패 콜백으로 끝난다).
# 요청 큐 URL이 없으면 컨슈머는 시작하지 않는다.
AWS_REGION=ap-northeast-2
SQS_REQUEST_QUEUE_URL=http://localhost:4566/000000000000/lovebug-llm-request
# 비워두면 실제 AWS SQS. docker-compose.local.yml의 LocalStack을 쓰려면
# http://localhost:4566 로 채운다(scripts/README.md 참고) — 실제 백엔드
# 없이 로컬에서 전체 흐름(큐→처리→큐)을 확인할 수 있다.
SQS_ENDPOINT_URL=http://localhost:4566
# Spring 콜백 주소. 워커를 호스트에서 실행하면 기본값(http://localhost:8080)을
# 써도 되고, 컨테이너에서 실행하면 보통 http://host.docker.internal:8080 이다.
BACKEND_CALLBACK_BASE_URL=http://localhost:8080
# LocalStack은 자격증명을 검증하지 않지만 boto3는 뭐라도 있어야 한다 —
# LocalStack 쓸 때만 아무 문자열이나 채운다(실제 AWS에선 IAM 역할을 쓰므로 비워둔다).
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# ── MySQL ─────────────────────────────────────────────────
# app/backend_db.py가 백엔드(Spring) DB에서 문서 본문(document/
# document_version.body)·사전집 용어(term)를 **읽기 전용**으로 조회한다.
# 모델 호출 멱등은 이 MySQL이 아니라 아래 REDIS_URL의 Redis 선점이 담당한다.
# 로컬은 final/backend의
# compose.yaml이 띄우는 MySQL 컨테이너를 그대로 쓴다(별도 인스턴스 안 둠).
#
# 로컬에서 포트 확인하는 법: `docker port backend-mysql-1` — 컨테이너
# 재시작마다 호스트 포트가 바뀔 수 있다(Docker가 임의 포트를 새로 배정).
# `processed_jobs`는 이전 응답 큐 설계의 미사용 유산이다. 새로 만들거나 이 DB에
# 쓰지 않는다 — 삭제는 별도 정리 작업에서 수행한다.
MYSQL_HOST=localhost
MYSQL_PORT=
MYSQL_USER=ubidict
MYSQL_PASSWORD=ubidict
MYSQL_DATABASE=ubidict

# ── Redis — 모델 호출 선점 ────────────────────────────────
# mode=REAL 요청을 받기 전에 채워야 한다. 워커는 모델을 부르기 직전
# `SET llm:request:{requestId} NX EX 3000`으로 선점하고, 실패하면 그 메시지로는
# 모델을 부르지 않고 지운다 — SQS 표준 큐가 at-least-once 라 같은 메시지가 두 번
# 배달되면 이것이 없을 때 모델을 두 번 부르고 요금도 두 배로 나간다
# (docs/AI_CONTRACT.md 7-2-2, D-111·D-113).
#
# **비워 두면 REAL 작업이 실패 콜백으로 끝난다.** 선점 여부를 모르는 채 부르지
# 않는다. STUB·MOCK 만 쓰는 로컬 개발은 이 값 없이 그대로 돈다.
#
# 로컬은 docker-compose.local.yml 의 redis 를 쓴다.
REDIS_URL=redis://localhost:6379/0
# Spring prod Job timeout(PT50M) 이상이어야 한다. 기본값도 3000초다.
LLM_IDEMPOTENCY_TTL_SECONDS=3000
