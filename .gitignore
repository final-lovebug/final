# 로컬 Compose 오버라이드 (루트 / 하위 프로젝트 공통)
compose.override.yaml
compose.override.yml

# 시크릿 (루트 compose.yaml이 GOOGLE_CLIENT_ID/SECRET 보간에 쓴다 — 커밋 금지)
.env
.env.*
!.env.example

# 개인 작업 추적용 (커밋 안 함)
/task/
/backend/task/

# IDE 설정 (IntelliJ)
/.idea/

# Gradle 로컬 캐시
/.gradle/
/build/

# 배포 번들 생성 산출물
deploy/IMAGE_TAG
/.aws/
/AGENTS.md
/backend/.env
