# 로컬 개발용 예시 파일. 복사해서 .env.local로 저장한다(커밋 금지 — *.local 이미 .gitignore).
#   cp .env.local.example .env.local
#
# 백엔드를 로컬에서 8080 포트로 띄운 뒤 사용한다:
#   cd backend && ./gradlew bootRun --args='--spring.profiles.active=local'
#
# 값을 아예 설정하지 않아도 frontend/src/shared/config/env.ts의 기본값(http://localhost:8080)이
# 적용되므로 로컬 기본 구성이라면 이 파일이 없어도 동작한다. 백엔드를 다른 포트/호스트에서
# 띄우거나 배포 환경을 가리킬 때만 실제로 필요하다.
VITE_API_BASE_URL=http://localhost:8080
